# Copy to deployment/.env (not committed) and adjust. Read by docker compose.
# Where OpenSearch keeps its index data and snapshots (default: the repo's data/ dir).
OPENSEARCH_DATA=../data/opensearch
OPENSEARCH_SNAPSHOTS=../data/snapshots
# JVM heap and container memory. Vector search is mmap-heavy: leave RAM for the page cache.
OPENSEARCH_HEAP=12g
OPENSEARCH_MEM_LIMIT=20g
# Security plugin is disabled (OpenSearch binds to 127.0.0.1 only); the image still wants a value.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CourtSearch_ChangeMe_1
